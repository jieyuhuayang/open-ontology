# Database (defaults work with docker-compose)
# DATABASE_URL=postgresql+asyncpg://ontology:ontology@localhost:5432/open_ontology

# Encryption key for data connections (empty = auto-generate in dev mode)
ENCRYPTION_KEY=

# LLM Configuration (required for Agent / Sidekick features)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=claude-sonnet-4-6
# SIDEKICK_MODEL=
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.3
# LLM_TOKEN_BUDGET=100000
# LLM_MAX_STEPS=50
